APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=x_grow
DB_USERNAME=xgrow
DB_PASSWORD=

# OpenAI — used by app/Services/ClaudeService.php
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com

# X (Twitter) API — OAuth2 user-context posting, requires a paid API tier
# for write access. Used by ConnectXController and app/Services/XPostingService.php
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8001/connect/x/callback

# LinkedIn API — OAuth2 member posting. The LinkedIn app needs the
# "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn"
# products. Used by ConnectLinkedInController and LinkedInPostingService.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8001/connect/linkedin/callback
LINKEDIN_API_VERSION=202506

# Posting as a LinkedIn company page needs a SECOND LinkedIn app: the
# Community Management API product "requires that it be the only product on
# the application", so it cannot sit alongside the sign-in/share products
# above. Create a separate app with only that product and put its
# credentials here; leave blank to disable page support.
LINKEDIN_PAGES_CLIENT_ID=
LINKEDIN_PAGES_CLIENT_SECRET=
LINKEDIN_PAGES_REDIRECT_URI=http://localhost:8001/connect/linkedin/pages/callback
# Must match the pages app's "OAuth 2.0 scopes" box exactly.
LINKEDIN_PAGES_SCOPES="w_organization_social rw_organization_admin"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
